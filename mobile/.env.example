# Same Supabase project as the web app — Project Settings -> API.
# Expo only exposes vars prefixed EXPO_PUBLIC_ to app code.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# The deployed web app — its /api/insights route powers the Insights screen.
# For local dev, use your machine's LAN IP (not "localhost" — that's the
# phone itself), e.g. http://192.168.1.20:3000
EXPO_PUBLIC_WEB_APP_URL=https://your-app.vercel.app
