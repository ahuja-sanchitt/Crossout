# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Same project, exposed to the browser — used by the Next.js app (RLS-scoped,
# safe to expose; NEXT_PUBLIC_ vars are bundled into client code)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Single-user Phase 1: the auth.users.id for the one account these scripts operate on
CROSSOUT_USER_ID=00000000-0000-0000-0000-000000000000
